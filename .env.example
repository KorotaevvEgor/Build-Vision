# Переменные окружения для docker-compose.yml / admin_panel/settings.py / backend.
# Скопируйте в `.env` (не коммитится, см. .gitignore) и заполните реальными значениями
# перед `docker compose up`. Все значения ниже — примеры, не рабочие секреты.

# --- PostgreSQL ---
POSTGRES_DB=stroykontrol
POSTGRES_USER=stroykontrol
POSTGRES_PASSWORD=change-me

# --- Django ---
# Сгенерируйте случайную строку (например: python -c "import secrets; print(secrets.token_urlsafe(50))").
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=your-domain.example,www.your-domain.example
# Домены, с которых разрешены изменяющие запросы (CSRF) — обычно совпадает с ALLOWED_HOSTS, но с схемой.
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example,https://www.your-domain.example
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- BuildVision (SK_*) ---
# Пароль для единственного демонстрационного аккаунта "Участник проекта" — без него новый
# участник не сможет войти (см. README).
SK_PARTICIPANT_PASSWORD=change-me
# true в продакшене за HTTPS/nginx — иначе браузер не примет cookie сессии на кросс-доменных запросах.
SK_SESSION_COOKIE_SECURE=false
# Общий домен cookie для основного сайта и поддомена admin, например .your-domain.example.
# Пусто — cookie ставится только для конкретного хоста (подходит для локальной разработки).
SK_SESSION_COOKIE_DOMAIN=
# Список разрешённых origin через запятую — обязательно перечислите ваш домен в продакшене.
SK_CORS_ORIGINS=http://localhost:5173,https://localhost,https://your-domain.example

# --- Языковая модель (AI Learning заключения, ИИ-ассистент проекта) ---
# Опционально: без ключа эти функции честно отключаются (available: false), остальной функционал не страдает.
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
AITUNNEL_TEXT_MODEL=claude-sonnet-4.6
AITUNNEL_VISION_MODEL=claude-sonnet-4.6
